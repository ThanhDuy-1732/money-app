## Production Environment Variables
## DO NOT commit actual values to version control.
## Copy this file to .env.production and fill in real values from Supabase Cloud, VNPay dashboard, and Vercel.

# Database (Supabase Cloud) — from Step 1
# Get these from Supabase Dashboard → Project Settings → Database
POSTGRES_PASSWORD=<your-production-database-password>
POSTGRES_DB=postgres
DB_HOST=<your-production-db-host>.supabase.co
DB_PORT=5432
DB_USER=postgres

# JWT (Supabase Cloud)
# These are auto-generated by Supabase Cloud, visible in Project Settings → API
JWT_SECRET=<your-supabase-jwt-secret>
JWT_EXPIRY=3600

# Supabase API Keys (Supabase Cloud) — from Step 1
# Get from Supabase Dashboard → Project Settings → API
ANON_KEY=<your-supabase-anon-key>
SERVICE_ROLE_KEY=<your-supabase-service-role-key>

# Supabase URLs — from Step 1
# Get from Supabase Dashboard → Project Settings → API
API_EXTERNAL_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<your-supabase-anon-key>

# Frontend domain — your production domain
SITE_URL=https://your-production-domain.com
NEXT_PUBLIC_SITE_URL=https://your-production-domain.com

# Additional OAuth redirect URLs (if needed)
ADDITIONAL_REDIRECT_URLS=

# SECRET_KEY_BASE — used by Realtime service
# Must be a 64-byte base64-encoded string. Generate with: openssl rand -base64 64
SECRET_KEY_BASE=<your-64-byte-base64-encoded-secret>

# Google OAuth (optional, for login)
ENABLE_GOOGLE_AUTH=false
GOOGLE_CLIENT_ID=<your-google-client-id-if-enabled>
GOOGLE_SECRET=<your-google-secret-if-enabled>

# VNPay Production (Step 2) — from VNPay merchant dashboard
# WARNING: These are production credentials. Keep them secure and rotate regularly.
# Get from VNPay Dashboard → Merchant Settings
VNPAY_TMN_CODE=<your-production-vnpay-tmn-code>
VNPAY_HASH_SECRET=<your-production-vnpay-hash-secret>
VNPAY_URL=https://pay.vnpay.vn/vpcpay.html
# DO NOT set VNPAY_MOCK in production — leaving it unset disables mock mode

# Vercel Environment (Step 4)
NODE_ENV=production

# Optional: Monitoring and Logging
# Sentry DSN for error tracking (optional, add when ready)
# NEXT_PUBLIC_SENTRY_DSN=<your-sentry-dsn>

# Posthog or other analytics (optional)
# NEXT_PUBLIC_ANALYTICS_KEY=<your-analytics-key>
