## Supabase Local Dev — copy file này thành .env và dùng ngay, không cần thay đổi gì
## Các key bên dưới là key mặc định của Supabase local dev (PUBLIC, chỉ dùng local)

POSTGRES_PASSWORD=postgres
POSTGRES_DB=postgres

JWT_SECRET=super-secret-jwt-token-with-at-least-32-characters-long
JWT_EXPIRY=3600

# Key mặc định Supabase local dev (ký bởi JWT_SECRET trên)
ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRFA0NiK7W9oaKFqYedj9TkX2Z4e7ePHOE_Y6jBg0lQ
SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.EGIM96RAZx35lJzdJsyH-qQwv8Hj04zWl196z2-SBc0

API_EXTERNAL_URL=http://localhost:8000
SITE_URL=http://localhost:3000
ADDITIONAL_REDIRECT_URLS=

# Bật Google OAuth khi có Client ID/Secret từ Google Cloud Console
ENABLE_GOOGLE_AUTH=false
GOOGLE_CLIENT_ID=
GOOGLE_SECRET=

# SECRET_KEY_BASE dùng bởi Realtime service
